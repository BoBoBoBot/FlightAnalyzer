<Window x:Class="FlightAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:scottplot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:vm="clr-namespace:FlightAnalyzer.ViewModels"
        xmlns:local="clr-namespace:FlightAnalyzer"
        Title="飞行数据分析" Height="750" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <DockPanel Grid.Row="0" Margin="4,0,0,6">
            <Button DockPanel.Dock="Left"
                    ToolTip="只支持csv格式"
                    Command="{Binding ImportFileCommand}"
                    Padding="14,8" Margin="0,0,8,0" 
                    FontSize="14"
                    IsEnabled="{Binding IsImporting, Converter={StaticResource BoolInvertConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" 
                               Margin="0,0,5,0"
                               FontFamily="{StaticResource SymbolThemeFontFamily}" 
                               Text="&#xE838;"/>
                    <TextBlock Text="打开文件"/>
                </StackPanel>
            </Button>
            <Button Content="清空图表" 
                    Command="{Binding ClearAllCurvesCommand}" 
                    Padding="10,8" 
                    Visibility="Collapsed"
                    DockPanel.Dock="Left"
                    Margin="0,0,8,0"/>
            <Button Command="{Binding ClearAllCommand}"
                    Padding="10,8" 
                    DockPanel.Dock="Left"
                    Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}"
                               Text="&#xE74D;"
                               VerticalAlignment="Center" 
                               Margin="0,0,5,0"/>
                    <TextBlock Text="全部清空"/>
                </StackPanel>
            </Button>
            
            <Button Margin="12,0,3,0"
                    Padding="10,8" 
                    ToolTip="设置" 
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Click="SettingsButton_Click">
                <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" Text="&#xE713;"/>
            </Button>
        </DockPanel>
        <ProgressBar Grid.Row="1"
                     Value="{Binding ProgressValue}" 
                     Margin="4,0,4,0"
                     Minimum="0" 
                     Maximum="100"
                     Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVisConverter}}"/>

        <!-- 主体 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：数据树（支持拖拽文件加载） -->
            <Border Grid.Column="0" CornerRadius="6" Margin="4"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    Background="Transparent"
                    AllowDrop="True"
                    DragEnter="DataArea_DragEnter"
                    DragOver="DataArea_DragOver"
                    DragLeave="DataArea_DragLeave"
                    Drop="DataArea_Drop">
                <DockPanel>
                    <Label Content="数据列表" DockPanel.Dock="Top" Margin="7" FontWeight="DemiBold"/>

                    <TextBox DockPanel.Dock="Top"
                                 Grid.Column="1"
                                 Margin="5,0,5,5" Height="30"
                             VerticalContentAlignment="Center"
                             x:Name="SearchBox" TextChanged="SearchBox_TextChanged" Cursor="IBeam">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Tag" Value="搜索列名..."/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TreeView x:Name="DataTreeView"
                              
                              ItemsSource="{Binding FileTree}"
                              BorderThickness="0" Margin="5"
                              SelectedItemChanged="DataTreeView_SelectedItemChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem"
                                   BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=OneWay}"/>
                                <Setter Property="FontSize" Value="14"/>
                                
                                <Setter Property="Padding" Value="4,2"/>
                                <Style.Triggers>
                                    <!-- 列节点：根据 IsVisible 控制可见性 -->
                                    <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vm:FileNode}"
                                                      ItemsSource="{Binding Columns}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13"
                                               TextTrimming="CharacterEllipsis" MaxWidth="200"
                                               ToolTip="{Binding FileName}"/>
                                    <TextBlock Text="{Binding Columns.Count, StringFormat=' ({0})'}"
                                               Foreground="Gray" FontSize="13" Margin="6,0,0,0"
                                               VerticalAlignment="Center"/>
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="删除此文件" Click="DeleteFileNode_Click">
                                                <MenuItem.Icon>
                                                    <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" Text="&#xE74D;"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                            <DataTemplate DataType="{x:Type vm:ColumnNode}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="13"/>
                                    <TextBlock Text="  已加载" FontSize="12" Foreground="Green"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsPlotted, Converter={StaticResource BoolToVisConverter}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- 右侧：多图表区域 -->
            <Grid Grid.Column="1">
                <ItemsControl ItemsSource="{Binding ChartPanels}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <!-- 默认：1列垂直布局（1/2/3个图表） -->
                            <Setter Property="ItemsPanel">
                                <Setter.Value>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="1"/>
                                    </ItemsPanelTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <!-- 4个图表：2×2 -->
                                <DataTrigger Binding="{Binding PanelCount}" Value="4">
                                    <Setter Property="ItemsPanel">
                                        <Setter.Value>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2"/>
                                            </ItemsPanelTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <!-- 6个图表：2列×3行 -->
                                <DataTrigger Binding="{Binding PanelCount}" Value="6">
                                    <Setter Property="ItemsPanel">
                                        <Setter.Value>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2"/>
                                            </ItemsPanelTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ChartPanel}">
                            <Border Margin="3" CornerRadius="6"
                                    BorderThickness="1"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                    AllowDrop="True"
                                    DragEnter="ChartArea_DragEnter"
                                    DragOver="ChartArea_DragOver"
                                    DragLeave="ChartArea_DragLeave"
                                    Drop="ChartArea_Drop">
                                <Border.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="X轴设置" FontSize="13">
                                            <MenuItem.Icon>
                                                <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" Text="&#xE8F1;"/>
                                            </MenuItem.Icon>
                                            <MenuItem Header="按照索引排列"
                                                      Click="XAxisMode_IndexBased_Click"
                                                      FontSize="13"/>
                                            <MenuItem Header="按照该列排列"
                                                      Click="XAxisMode_ColumnBased_Click"
                                                      FontSize="13"/>
                                            <Separator/>
                                            <MenuItem Header="选择X轴列" FontSize="13" x:Name="XAxisColumnMenuItem"
                                                      SubmenuOpened="XAxisColumnMenuItem_SubmenuOpened">
                                                <MenuItem.Icon>
                                                    <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" Text="&#xE8F1;"/>
                                                </MenuItem.Icon>
                                                <!-- 子菜单项将在代码中动态生成 -->
                                            </MenuItem>
                                        </MenuItem>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <!-- 图表 -->
                                    <scottplot:WpfPlot Grid.Row="0"
                                                       Loaded="Chart_Loaded"
                                                       Margin="2"/>


                                    <!-- 底部信息 -->
                                    <Border Grid.Row="0" Margin="65,15,2,2"  
                                            MaxHeight="180" 
                                            Background="Transparent"
                                            VerticalAlignment="Top"  
                                            HorizontalAlignment="Left">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Curves}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Vertical"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:CurveItem}">
                                                        <Border CornerRadius="4" Padding="5,3,5,3" Margin="2"
                                                                BorderThickness="1.5"
                                                                BorderBrush="{DynamicResource ControlElevationBorderBrush}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background"
                                                                            Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                                                                    <Style.Triggers>
                                                                        <!-- 当 “X” 被鼠标悬停时，改变背景色 -->
                                                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=RemoveTextBlock}"
                                                                                     Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                                                            <!-- 改成你想要的高亮色 -->
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="20"/>
                                                                </Grid.ColumnDefinitions>
                                                           
                                                                    

                                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                                    <Border Width="15" Height="4" CornerRadius="2"
                                                                            Background="{Binding Brush}"
                                                                            VerticalAlignment="Center" Margin="0,0,4,0">
                                                                    </Border>
                                                                    <TextBlock Text="{Binding LegendText}" 
                                                                                VerticalAlignment="Center"
                                                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                                                                FontSize="13"/>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" x:Name="RemoveTextBlock"
                                                                           Text=" X"
                                                                           Margin="4,0,0,0"
                                                                           Foreground="#E74856"
                                                                           Cursor="Hand"
                                                                           VerticalAlignment="Center"
                                                                           HorizontalAlignment="Center"
                                                                           Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=3}}"
                                                                           MouseLeftButtonUp="CurveRemove_Click">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="FontSize" Value="13"/>
                                                                            <Style.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter Property="FontSize" Value="15"/>
                                                                                    <!-- 悬停时变大 -->
                                                                                </Trigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="3" Margin="5,6,4,0">
            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="12" VerticalAlignment="Center" Foreground="Gray" Text="{Binding StatusText, Mode=OneWay}"/>


                <TextBlock FontSize="12"
                           Grid.Column="1"
                           VerticalAlignment="Center" 
                           Foreground="Gray">
                    <Run Text="飞行时间:"/>
                    <Run Text="{Binding FlightTimeDisplay, Mode=OneWay}"/>
                </TextBlock>


                <!--<DockPanel Grid.Column="2">
                    <Button HorizontalAlignment="Right"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Padding="0" 
                            Height="20"
                            Width="20"
                            DockPanel.Dock="Right"> 
                        <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="18"
                                   Text="&#xE80A;"/>
                    </Button>
                    <Button HorizontalAlignment="Right"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Padding="0" 
                            Height="20"
                            Width="20"
                            DockPanel.Dock="Right">
                        <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="18"
                                   Text="&#xECA5;"/>
                    </Button>
                    <Button HorizontalAlignment="Right"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Padding="0" 
                            Height="20"
                            Width="20"
                            DockPanel.Dock="Right">
                        <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="18"
                                   Text="&#xF16D;"/>
                    </Button>
                    <Button HorizontalAlignment="Right"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Padding="0" 
                            Height="20"
                            Width="20"
                            DockPanel.Dock="Right">
                        <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="18"
                                   Text="&#xF16B;"/>
                    </Button>

                    --><!--<TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" 
                               HorizontalAlignment="Right"
                               DockPanel.Dock="Right"
                               Text="&#xF16D;"/>
                    <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" 
                               HorizontalAlignment="Right"
                               DockPanel.Dock="Right"
                               Text="&#xF16D;"/>
                    <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" 
                               HorizontalAlignment="Right"
                               DockPanel.Dock="Right"
                               Text="&#xF16B;"/>--><!--
                </DockPanel>-->
            </Grid>
        </Border>
    </Grid>
</Window>
