<Window x:Class="FlightAnalyzer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="500" Width="429"
        WindowStartupLocation="CenterOwner"
        MinHeight="400" MinWidth="350"
        ResizeMode="CanResizeWithGrip">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer>
            
        
        <StackPanel Margin="20,20">
            <TextBlock Text="设置" FontSize="18" FontWeight="SemiBold" Margin="3,0,0,15"/>

            <Expander Header="主题" Margin="2">
                <StackPanel x:Name="ThemePanel" Orientation="Vertical" >
                    <RadioButton Content="Light" Margin="0,0,16,0" FontSize="13"
                                 GroupName="Theme" Checked="ThemeRadio_Checked"/>
                    <RadioButton Content="Dark" Margin="0,0,16,0" FontSize="13"
                                 GroupName="Theme" Checked="ThemeRadio_Checked"/>
                    <RadioButton Content="System" FontSize="13"
                                 GroupName="Theme" Checked="ThemeRadio_Checked"/>
                </StackPanel>
            </Expander>

            <!-- 主题 -->
            <!--<StackPanel Grid.Row="1" Margin="0,0,0,16">
                <TextBlock Text="主题" FontSize="14" Margin="0,0,0,6"/>
                <StackPanel x:Name="ThemePanel" Orientation="Horizontal">
                    <RadioButton Content="Light" Margin="0,0,16,0" FontSize="13"
                                 GroupName="Theme" Checked="ThemeRadio_Checked"/>
                    <RadioButton Content="Dark" Margin="0,0,16,0" FontSize="13"
                                 GroupName="Theme" Checked="ThemeRadio_Checked"/>
                    <RadioButton Content="System" FontSize="13"
                                 GroupName="Theme" Checked="ThemeRadio_Checked"/>
                </StackPanel>
            </StackPanel>-->

            <!-- 图表 -->
            <Expander Header="图表设置" Margin="2" IsExpanded="True">
                <StackPanel Grid.Row="2" >
                    <DockPanel Margin="0,3,0,3">
                        <TextBlock Text="图表数量" 
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center" 
                                   FontSize="13" 
                                   Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding PanelCountOptions}"
                                  HorizontalAlignment="Right"

                                  SelectedItem="{Binding PanelCount}" Width="100" FontSize="13"/>
                    </DockPanel>

                    <DockPanel Margin="0,3,0,3">
                        <TextBlock Text="对其联动"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Margin="0,0,8,0"/>
                        <CheckBox Margin="0,6,0,0"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom"
                                  IsChecked="{Binding SyncZoom}"/>
                    </DockPanel>

                    <DockPanel Margin="0,3,0,3">
                        <TextBlock Text="捕捉数据行"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Margin="0,0,8,0"
                                   ToolTip="鼠标位置必须对应一行原始数据（至少有一个非插值点）"/>
                        <CheckBox Margin="0,6,0,0"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom"
                                  IsChecked="{Binding SnapToDataRow}"/>
                    </DockPanel>

                    <DockPanel Margin="0,3,0,3">
                        <TextBlock Text="显示数据点"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Margin="0,0,8,0"
                                   ToolTip="在折线上显示实际数据点标记"/>
                        <CheckBox Margin="0,6,0,0"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom"
                                  IsChecked="{Binding ShowDataPoints}"/>
                    </DockPanel>

                    <DockPanel Margin="0,3,0,3">
                        <TextBlock Text="数据点大小"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Margin="0,0,8,0"
                                   ToolTip="调整图表中数据点的大小"/>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Slider Width="100"
                                    Minimum="1"
                                    Maximum="10"
                                    TickFrequency="0.5"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding DataPointSize, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{Binding DataPointSize, StringFormat=F1}"
                                       Width="30"
                                       VerticalAlignment="Center"
                                       Margin="5,0,0,0"
                                       FontSize="12"/>
                        </StackPanel>
                    </DockPanel>


                </StackPanel>
            </Expander>

            <!-- 飞行时间 -->
            <Expander Header="飞行时间" Margin="2" IsExpanded="False">
                <StackPanel Grid.Row="2" >
                    <DockPanel Margin="0,3,0,3">
                        <TextBlock Text="每帧数据间隔时间" 
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center" 
                                   FontSize="13" 
                                   Margin="0,0,8,0"/>
                        <TextBlock HorizontalAlignment="Right" 
                                   VerticalAlignment ="Center"
                                   DockPanel.Dock="Right"
                                   Text=" ms"/>
                        <TextBox HorizontalAlignment="Right"
                                 VerticalAlignment ="Center"
                                 DockPanel.Dock="Right"
                                 Width="100" FontSize="13"
                                 Text="{Binding FrameIntervalMs, UpdateSourceTrigger=LostFocus}"/>

                    </DockPanel>




                </StackPanel>
            </Expander>

            <!-- 按钮 -->

        </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Content="确定" Width="80" Padding="0,6" Margin="0,0,10,0"
                        Command="{Binding OkCommand}"/>
            <Button Content="取消" Width="80" Padding="0,6"
                        Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</Window>
